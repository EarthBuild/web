{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "url": [
        "/",
        "/install/",
        "/faq/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless --disable-gpu --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.90
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "color-contrast": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "image-alt": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "link-name": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "button-name": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "document-title": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "html-has-lang": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "meta-viewport": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.90
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.90
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}