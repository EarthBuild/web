[0.05, "o", "\u001b[1;36m$ earth +docker\u001b[0m\r\n"]
[0.15, "o", "\u001b[90m─── Init 🚀 Found buildkit daemon as podman container (earth-buildkitd)\u001b[0m\r\n"]
[0.25, "o", "\u001b[1m─── Build 🔧\u001b[0m\r\n"]
[0.35, "o", "   \u001b[36m+deps\u001b[0m  | \u001b[32m*cached*\u001b[0m --> FROM amazoncorretto:25.0.4 (Gradle 8.7 + OpenJDK 21)\r\n"]
[0.45, "o", "  \u001b[36m+build\u001b[0m  | \u001b[32m*cached*\u001b[0m --> RUN gradle build && gradle install\r\n"]
