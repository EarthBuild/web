[0.05, "o", "\u001b[1;36m$ earth +build\u001b[0m\r\n"]
[0.15, "o", "\u001b[90m─── Init 🚀 Found buildkit daemon as podman container (earth-buildkitd)\u001b[0m\r\n"]
[0.25, "o", "\u001b[1m─── Build 🔧\u001b[0m\r\n"]
[0.35, "o", "   \u001b[36m+base\u001b[0m   | \u001b[32m*cached*\u001b[0m --> FROM node:20-alpine3.19\r\n"]
[0.45, "o", "   \u001b[36m+deps\u001b[0m   | \u001b[32m*cached*\u001b[0m --> COPY package.json package-lock.json ./\r\n"]
[0.55, "o", "   \u001b[36m+deps\u001b[0m   | \u001b[32m*cached*\u001b[0m --> RUN --mount=type=cache,target=/root/.npm npm ci\r\n"]
[0.65, "o", "   \u001b[36m+src\u001b[0m    | \u001b[32m*cached*\u001b[0m --> COPY src/ webpack.config.js ./\r\n"]
[0.75, "o", "  \u001b[36m+build\u001b[0m   | \u001b[32m*cached*\u001b[0m --> RUN npm run build (Webpack 5)\r\n"]
[0.85, "o", "  \u001b[36m+build\u001b[0m   | \u001b[32m*cached*\u001b[0m --> SAVE ARTIFACT dist/ /dist AS LOCAL dist/\r\n"]
[1.00, "o", "\u001b[1;32m=========================== 🌍 Earth Build  ✅ SUCCESS [0.8s] ===========================\u001b[0m\r\n"]
