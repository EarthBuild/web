[0.05, "o", "\u001b[1;36m$ earth +build\u001b[0m\r\n"]
[0.15, "o", "\u001b[90m─── Init 🚀 Found buildkit daemon as podman container (earth-buildkitd)\u001b[0m\r\n"]
[0.25, "o", "\u001b[1m─── Build 🔧\u001b[0m\r\n"]
[0.60, "o", "   \u001b[36m+base\u001b[0m   | --> FROM node:26.7.0-alpine3.23\r\n"]
[1.20, "o", "   \u001b[36m+deps\u001b[0m   | --> COPY package.json npm-shrinkwrap.json ./\r\n"]
