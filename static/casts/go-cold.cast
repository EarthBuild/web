[0.05, "o", "\u001b[1;36m$ earth +build\u001b[0m\r\n"]
[0.15, "o", "\u001b[90m─── Init 🚀 Found buildkit daemon as podman container (earth-buildkitd)\u001b[0m\r\n"]
[0.25, "o", "\u001b[1m─── Build 🔧\u001b[0m\r\n"]
[0.50, "o", "   \u001b[36m+base\u001b[0m  | --> FROM golang:1.27-alpine3.24\r\n"]
[1.00, "o", "   \u001b[36m+base\u001b[0m  | [internal] pulling image docker.io/library/golang:1.27-alpine3.24\r\n"]
[1.80, "o", "   \u001b[36m+base\u001b[0m  | --> WORKDIR /go-example\r\n"]
[2.20, "o", "   \u001b[36m+deps\u001b[0m  | --> COPY go.mod go.sum ./\r\n"]
[2.60, "o", "   \u001b[36m+deps\u001b[0m  | --> RUN go mod download\r\n"]
[3.50, "o", "  \u001b[36m+build\u001b[0m  | --> COPY main.go .\r\n"]
[4.20, "o", "  \u001b[36m+build\u001b[0m  | --> RUN go build -o build/go-example main.go\r\n"]
[5.60, "o", "  \u001b[36m+build\u001b[0m  | --> SAVE ARTIFACT build/go-example AS LOCAL build/go-example\r\n"]
[6.20, "o", "\u001b[1;32m=========================== 🌍 Earth Build  ✅ SUCCESS [6.2s] ===========================\u001b[0m\r\n"]
[6.25, "o", "\u001b[90mOutput saved: ./build/go-example (4.2 MB)\u001b[0m\r\n"]
